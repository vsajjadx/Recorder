<Application x:Class="Recorder.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#101318"/><SolidColorBrush x:Key="Panel" Color="#181D24"/><SolidColorBrush x:Key="Text" Color="#F4F7FB"/><SolidColorBrush x:Key="Muted" Color="#8D98A8"/><SolidColorBrush x:Key="Accent" Color="#6C63FF"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#252C37"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,8,0,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Application.Resources>
</Application>
