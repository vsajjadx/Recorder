<Window x:Class="Recorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recorder" Width="520" Height="410" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" ResizeMode="NoResize">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="RECORDER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Capture your Windows desktop" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Native resolution · native refresh rate · one-click recording" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="0,24,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="DISPLAY" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DisplayText" Text="Detecting…" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="STATUS" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatusText" Text="Ready" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border>
  <StackPanel Grid.Row="2"><TextBlock Text="Save recordings to" Foreground="{StaticResource Muted}"/><TextBox x:Name="PathBox" Text="C:\Users\Public\Videos\Recorder" Background="#202631" Foreground="{StaticResource Text}" BorderThickness="0" Padding="12" Margin="0,7,0,0"/><Button x:Name="RecordButton" Click="Record_Click" Background="{StaticResource Accent}" Content="START RECORDING" Height="48" Margin="0,18,0,0"/></StackPanel>
  <TextBlock Grid.Row="3" x:Name="Footer" Text="Hardware-friendly H.264 · MP4 output" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
 </Grid>
</Window>
