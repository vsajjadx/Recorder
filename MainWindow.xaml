<Window x:Class="Recorder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recorder" Width="660" Height="780" MinWidth="550" MinHeight="550" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
 <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><StackPanel><StackPanel Orientation="Horizontal"><Border Background="#786BFF" CornerRadius="9" Width="34" Height="34" Margin="0,0,12,0"><Ellipse Width="13" Height="13" Fill="White"/></Border><TextBlock Text="Recorder" FontSize="27" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Your screen. Your sound. One click." Foreground="{StaticResource Muted}" Margin="0,10,0,0" FontSize="14"/></StackPanel><TextBlock Text="1.1" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
   <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="20" Margin="0,0,0,14"><StackPanel>
    <TextBlock Text="SCREEN" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
    <ComboBox x:Name="DisplayBox" AutomationProperties.Name="Screen" SelectionChanged="Display_Changed"/>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="RESOLUTION" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ResolutionText" FontSize="17" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="FRAME RATE" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="FpsText" FontSize="17" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="QUALITY" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="High · H.264" FontSize="17" Margin="0,4,0,0" FontWeight="SemiBold"/></StackPanel>
    </Grid>
   </StackPanel></Border>
   <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="20" Margin="0,0,0,14"><StackPanel>
    <CheckBox x:Name="AudioToggle" Content="Record system audio" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>
    <TextBlock Text="Captures the current speakers or headphones." Foreground="{StaticResource Muted}" FontSize="12" Margin="50,5,0,17" TextWrapping="Wrap"/>
    <CheckBox x:Name="CursorToggle" Content="Show mouse cursor" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>
   </StackPanel></Border>
   <Border Background="{StaticResource Panel}" CornerRadius="13" Padding="20"><StackPanel>
    <Grid Margin="0,0,0,9"><TextBlock Text="SAVE TO" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="MP4" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PathBox" Height="44" VerticalContentAlignment="Center" AutomationProperties.Name="Recording folder" LostFocus="Path_LostFocus" ToolTip="Folder for your recordings"/><Button x:Name="BrowseButton" Height="44" Grid.Column="1" Content="Browse" Click="Browse_Click" Margin="10,0,0,0"/></Grid>
    <Button Content="Open recordings folder ↗" Click="OpenFolder_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#B6B0FF" FontSize="12" Padding="0,10,0,0"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0">
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StatusText" Text="Ready to record" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="DetailText" Text="Resolution and frame rate follow your display." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,12,0" TextWrapping="Wrap"/></StackPanel><TextBlock x:Name="TimerText" Grid.Column="1" Text="00:00:00" FontFamily="Consolas" FontSize="25" VerticalAlignment="Center"/></Grid>
   <Button x:Name="RecordButton" Click="Record_Click" Background="{StaticResource Accent}" BorderThickness="0" Height="56" FontSize="16" Content="●   Start recording" AutomationProperties.Name="Start recording"/>
   <TextBlock Text="Ctrl + Shift + R  ·  Start / stop from any app" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,9,0,0" x:Name="ShortcutText"/>
  </StackPanel>
 </Grid>
</Window>
